# Copy this file to secrets.toml and fill in your values.
# DO NOT commit secrets.toml to git — it should be in .gitignore.
#
# On Streamlit Community Cloud, set these in the app's Secrets UI instead
# (Settings → Secrets), not by committing this file.

neon_db = "postgresql://USER:PASSWORD@HOST.neon.tech/DBNAME?sslmode=require"
app_password = "your-strong-shared-password-here"

# Optional — controls what's shown on the dashboard UI.
# Kept in secrets so the public repo code stays free of personal info.
patient_name = "Patient"
patient_dx = ""
app_title = "Lab Tracker"

# Optional — meta description shown in link previews (WhatsApp, search engines, etc.)
meta_description = "Private lab tracker. Sign-in required."

# Optional — patient's usual / pre-illness weight in kg.
# When set, unlocks the Nutritional Risk Index (NRI) score, shown under the
# "Full Clinical Detail" expander on the Overview page (Nutrition Trajectory group).
# usual_weight_kg = 65.0

# Optional — static patient constants. These never change, so they live here
# rather than in the readings table. Each one unlocks additional scores in the
# "Full Clinical Detail" expander:
#   patient_age -> FIB-4, Cockcroft-Gault CrCl, CKD-EPI eGFR
#   patient_sex -> Cockcroft-Gault CrCl, CKD-EPI eGFR, GNRI
#   height_cm   -> BMI, GNRI, and the BMI<20 arm of the Fearon cachexia criteria
# patient_age = 65
# patient_sex = "Male"
# height_cm = 168
